# -------------------------------------------------------------
# PROVEEDOR PRINCIPAL: Google Gemini (Recomendado)
# Obtén tu clave gratis en https://aistudio.google.com/
# -------------------------------------------------------------
GEMINI_API_KEY=tu_gemini_api_key_aqui

# -------------------------------------------------------------
# PROVEEDORES DE RESPALDO (FALLBACK EN CASCADA)
# Si Gemini se queda sin cuota o da error 429, el sistema usará
# automáticamente el siguiente proveedor que tengas configurado:
# -------------------------------------------------------------

# --- ZENMUX (https://zenmux.ai) ---
# Si tienes una sola clave maestra de ZenMux, colócala aquí:
# Al configurar ZENMUX_API_KEY, el sistema rotará automáticamente entre los 3 modelos:
# 1) deepseek/deepseek-v4.1-flash
# 2) anthropic/claude-haiku-5.5
# 3) minimax/minimax-m3.1-flash
ZENMUX_API_KEY=

# (Opcional) Si quieres forzar un modelo específico en ZenMux:
# ZENMUX_MODEL=anthropic/claude-haiku-5.5

# (Opcional) Sobrescribir identificadores de modelos de ZenMux:
# ZENMUX_DEEPSEEK_MODEL=deepseek/deepseek-v4.1-flash
# ZENMUX_CLAUDE_MODEL=anthropic/claude-haiku-5.5
# ZENMUX_MINIMAX_MODEL=minimax/minimax-m3.1-flash

# (Opcional) Si te dieran claves individuales separadas por modelo:
# ZENMUX_DEEPSEEK_KEY=
# ZENMUX_CLAUDE_KEY=
# ZENMUX_MINIMAX_KEY=
# ZENMUX_BASE_URL=https://zenmux.ai/api/v1

# --- OTROS PROVEEDORES ---
# DeepSeek directo (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# Groq (Recomendado como respaldo gratis y ultra rápido con Llama 3.3 70B)
# Obtén tu clave gratis en: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# 2. OpenRouter (Acceso a cientos de modelos y modelos gratuitos)
# Obtén tu clave en: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 3. OpenAI (GPT-4o-mini)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# 4. Ollama (Modelos Locales - 100% offline y sin límites)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# -------------------------------------------------------------
# CONFIGURACIÓN DEL SERVIDOR Y GITHUB
# -------------------------------------------------------------
PORT=4000

# Opcional: Token personal de GitHub para evitar límites de tasa (5000 peticiones/hora)
# GITHUB_TOKEN=ghp_...
