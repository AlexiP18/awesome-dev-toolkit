# -------------------------------------------------------------
# ORDEN DE PRIORIDAD DE IA EN CASCADA:
# 1º DeepSeek (v4.1 Flash vía ZenMux o Directo)
# 2º MiniMax (3.1 Flash vía ZenMux)
# 3º Google Gemini (3.8 Flash)
# 4º Claude Haiku / Groq / OpenRouter / OpenAI / Ollama
# -------------------------------------------------------------

# --- ZENMUX (https://zenmux.ai) (1º y 2º en la cascada) ---
# Al configurar ZENMUX_API_KEY, el sistema usará primero DeepSeek Flash y luego MiniMax 3.1:
ZENMUX_API_KEY=

# (Opcional) Sobrescribir identificadores de modelos de ZenMux:
# ZENMUX_DEEPSEEK_MODEL=deepseek/deepseek-v4.1-flash
# ZENMUX_MINIMAX_MODEL=minimax/minimax-m3.1-flash
# ZENMUX_CLAUDE_MODEL=anthropic/claude-haiku-5.5

# (Opcional) Si quieres forzar un modelo específico en ZenMux:
# ZENMUX_MODEL=deepseek/deepseek-v4.1-flash

# (Opcional) Si te dieran claves individuales separadas por modelo en ZenMux:
# ZENMUX_DEEPSEEK_KEY=
# ZENMUX_MINIMAX_KEY=
# ZENMUX_CLAUDE_KEY=
# ZENMUX_BASE_URL=https://zenmux.ai/api/v1

# --- DEEPSEEK DIRECTO (https://platform.deepseek.com/) ---
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# --- 3º: GOOGLE GEMINI (https://aistudio.google.com/) ---
# Clave gratis en Google AI Studio (Gemini 3.8 Flash):
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Groq (Recomendado como respaldo gratis y ultra rápido con Llama 3.3 70B)
# Obtén tu clave gratis en: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# 2. OpenRouter (Acceso a cientos de modelos y modelos gratuitos)
# Obtén tu clave en: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 3. OpenAI (GPT-4o-mini)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# 4. Ollama (Modelos Locales - 100% offline y sin límites)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# -------------------------------------------------------------
# CONFIGURACIÓN DEL SERVIDOR Y GITHUB
# -------------------------------------------------------------
PORT=4000

# Opcional: Token personal de GitHub para evitar límites de tasa (5000 peticiones/hora)
# GITHUB_TOKEN=ghp_...
