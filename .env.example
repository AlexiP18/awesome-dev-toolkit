# -------------------------------------------------------------
# PROVEEDOR PRINCIPAL: Google Gemini (Recomendado)
# Obtén tu clave gratis en https://aistudio.google.com/
# -------------------------------------------------------------
GEMINI_API_KEY=tu_gemini_api_key_aqui

# -------------------------------------------------------------
# PROVEEDORES DE RESPALDO (FALLBACK EN CASCADA)
# Si Gemini se queda sin cuota o da error 429, el sistema usará
# automáticamente el siguiente proveedor que tengas configurado:
# -------------------------------------------------------------

# --- ZENMUX (https://zenmux.ai) ---
# Puedes configurar las claves individuales de cada modelo que obtuviste en ZenMux,
# o una sola clave ZENMUX_API_KEY maestra:

# ZenMux: DeepSeek Flash / V4
ZENMUX_DEEPSEEK_KEY=
# ZENMUX_DEEPSEEK_MODEL=zenmux/deepseek/deepseek-v4-flash

# ZenMux: Claude Code / Haiku (3.5 / 5.5)
ZENMUX_CLAUDE_KEY=
# ZENMUX_CLAUDE_MODEL=zenmux/anthropic/claude-3.5-haiku

# ZenMux: MiniMax 3.1 / 01
ZENMUX_MINIMAX_KEY=
# ZENMUX_MINIMAX_MODEL=zenmux/minimax/minimax-01

# Clave maestra de ZenMux (opcional si usas una sola clave para todo)
# ZENMUX_API_KEY=
# ZENMUX_BASE_URL=https://zenmux.ai/api/v1

# --- OTROS PROVEEDORES ---
# DeepSeek directo (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# Groq (Recomendado como respaldo gratis y ultra rápido con Llama 3.3 70B)
# Obtén tu clave gratis en: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# 2. OpenRouter (Acceso a cientos de modelos y modelos gratuitos)
# Obtén tu clave en: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 3. OpenAI (GPT-4o-mini)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# 4. Ollama (Modelos Locales - 100% offline y sin límites)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# -------------------------------------------------------------
# CONFIGURACIÓN DEL SERVIDOR Y GITHUB
# -------------------------------------------------------------
PORT=4000

# Opcional: Token personal de GitHub para evitar límites de tasa (5000 peticiones/hora)
# GITHUB_TOKEN=ghp_...
