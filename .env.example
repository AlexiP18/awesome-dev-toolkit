# -------------------------------------------------------------
# PROVEEDOR PRINCIPAL PREFERIDO:
# Valores: deepseek | nvidia | gemini | auto
# (Si configuras DEEPSEEK_API_KEY, el sistema usará DeepSeek Platform automáticamente)
# -------------------------------------------------------------
DEFAULT_AI_PROVIDER=deepseek

# --- 1º: DEEPSEEK DIRECTO OFICIAL (https://platform.deepseek.com/) ---
# Modelo en api-docs.deepseek.com: DeepSeek-V4.1-Flash-1017 (o alias: deepseek-flash)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=DeepSeek-V4.1-Flash-1017
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- 2º: GOOGLE GEMINI (https://aistudio.google.com/) ---
# Clave gratis en Google AI Studio (Gemini 3.8 Flash):
GEMINI_API_KEY=tu_gemini_api_key_aqui

# --- 3º: NVIDIA BUILD / NIM (https://build.nvidia.com) ---
# Clave gratis con 1000 créditos en NVIDIA Build:
NVIDIA_API_KEY=
# NVIDIA_MODEL=deepseek-v4.1-flash

# --- ZENMUX (https://zenmux.ai) ---
# ZENMUX_API_KEY=
# ZENMUX_DEEPSEEK_MODEL=deepseek/deepseek-v4.1-flash
# ZENMUX_MINIMAX_MODEL=minimax/minimax-m3.1-flash
# ZENMUX_CLAUDE_MODEL=anthropic/claude-haiku-5.5

# Groq (Recomendado como respaldo gratis y ultra rápido con Llama 3.3 70B)
# Obtén tu clave gratis en: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# 2. OpenRouter (Acceso a cientos de modelos y modelos gratuitos)
# Obtén tu clave en: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 3. OpenAI (GPT-4o-mini)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# 4. Ollama (Modelos Locales - 100% offline y sin límites)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# -------------------------------------------------------------
# CONFIGURACIÓN DEL SERVIDOR Y GITHUB
# -------------------------------------------------------------
PORT=4000

# Opcional: Token personal de GitHub para evitar límites de tasa (5000 peticiones/hora)
# y para guardar el catálogo en el repositorio. Sin este token el servidor sigue funcionando
# con el disco local y el respaldo del navegador.
# GITHUB_TOKEN=ghp_...
# GITHUB_REPO=AlexiP18/awesome-dev-toolkit
# GITHUB_BRANCH=main

# Cada cuánto (ms) se mira si main tiene commits nuevos en content/. 0 lo desactiva.
# GITHUB_PULL_INTERVAL_MS=300000
# GITHUB_SYNC_ON_START=0 omite el pull inicial (útil en local si no quieres pisar content/).
# Reintentos de un push ante 409, 422 o rate limit.
# GITHUB_SYNC_ATTEMPTS=4

# Si ADMIN_TOKEN está vacío, los POST/PATCH/DELETE siguen abiertos (comportamiento anterior).
# Si lo defines, esas rutas exigen la cabecera x-admin-token o Authorization: Bearer.
# El HTML que sirve este proceso (catálogo, /quick-save y /bookmarklet) inyecta el token
# en el fetch del navegador para que el bookmarklet siga funcionando. No lo pongas en git.
# ADMIN_TOKEN=

# Secreto del webhook de GitHub (push a main) que dispara un pull de content/.
# GITHUB_WEBHOOK_SECRET=

# Orígenes extra permitidos por CORS, separados por comas. El propio host siempre se permite.
# CORS_ORIGINS=

# Límite de /api/ingest, /api/authors/analyze y /api/tools/:slug/thread por IP.
# AI_RATE_LIMIT_MAX=30
# AI_RATE_LIMIT_WINDOW_MS=600000

# Timeouts y reintentos del scraper y de la cascada de IA (opcionales)
# AI_REQUEST_TIMEOUT_MS=45000
# AI_REQUEST_RETRIES=2
# SCRAPER_RETRIES=2
# HTTP_TIMEOUT_MS=8000
# HTTP_RETRIES=2
