# Clave de API de Google Gemini (Obtén una gratis en https://aistudio.google.com/)
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Puerto para el servidor local y el bookmarklet (por defecto 4000)
PORT=4000

# Opcional: Token personal de GitHub para evitar límites de tasa (rate limits) en repositorios públicos
# GITHUB_TOKEN=ghp_...
